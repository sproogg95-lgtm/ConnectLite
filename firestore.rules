rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user can read/write only their own profile document directly.
    // Cloud Functions (Admin SDK) bypass these rules entirely, which is how
    // registerUser() creates the initial profile doc for a brand-new user.
    match /users/{userId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Only accounts with the "admin" custom claim may list every user
    // document at once — this is what backs the in-app Admin Panel.
    match /users/{document=**} {
      allow list: if request.auth != null && request.auth.token.admin == true;
    }

    match /registrationThrottle/{docId} {
      allow read, write: if false; // Cloud Functions only, via Admin SDK
    }
  }
}
